{
  "openapi": "3.0.3",
  "info": {
    "title": "Sistema de Gestão de Assistência Técnica Informática",
    "description": "Sistema completo de gestão para assistência técnica informática. Controla técnicos, clientes, equipamentos, orçamentos, serviços, estoque, vendas, compras e relatórios.\n\n## Autenticação\nO sistema usa sessões PHP. Para aceder a rotas restritas, realize o login primeiro.\n\n## Navegação\nAs páginas são acedidas via o parâmetro `?url=<rota>` ou directamente pela URL amigável `/<rota>` (via mod_rewrite).",
    "version": "3.0.0",
    "contact": {
      "name": "António Jacinto",
      "email": "antjacinto11672@gmail.com"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost/oficina-de-equipamentos-informatico",
      "description": "Servidor local (XAMPP/WAMP)"
    }
  ],
  "tags": [
    { "name": "Sistema", "description": "Endpoints de sistema e monitorização" },
    { "name": "Autenticação", "description": "Login e logout" },
    { "name": "Pessoas", "description": "Técnicos, recepcionistas, fornecedores e clientes" },
    { "name": "Equipamentos", "description": "Gestão de equipamentos informáticos e entrada na oficina" },
    { "name": "Produtos & Estoque", "description": "Produtos, categorias e controlo de estoque" },
    { "name": "Orçamentos & Serviços", "description": "Orçamentos, serviços e tipos de serviço" },
    { "name": "Financeiro", "description": "Vendas, compras, contas a pagar e a receber" },
    { "name": "Relatórios & Dashboard", "description": "Dashboard, gráficos e relatórios" },
    { "name": "Comunicação", "description": "Chat interno" }
  ],
  "paths": {
    "/health.php": {
      "get": {
        "tags": ["Sistema"],
        "summary": "Health Check",
        "description": "Verifica o estado de saúde da aplicação: conexão com base de dados, dependências e extensões PHP.",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "Aplicação saudável",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "example": {
                  "status": "ok",
                  "app": "Sistema de Gestão de Assistência Técnica Informática",
                  "version": "3.0.0",
                  "php": "8.2.0",
                  "timestamp": "2026-06-17 10:00:00",
                  "checks": {
                    "config": { "status": "ok", "message": "Ficheiro .env encontrado" },
                    "dependencies": { "status": "ok", "message": "Dependências instaladas" },
                    "database": { "status": "ok", "message": "Conexão com MySQL estabelecida", "database": "mecanica", "host": "localhost" },
                    "php_extensions": { "status": "ok", "message": "Todas as extensões necessárias estão activas" }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Serviço indisponível (base de dados ou dependências com erro)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/login": {
      "get": {
        "tags": ["Autenticação"],
        "summary": "Página de Login",
        "description": "Exibe o formulário de autenticação.",
        "operationId": "loginPage",
        "responses": {
          "200": { "description": "Página HTML do formulário de login" }
        }
      },
      "post": {
        "tags": ["Autenticação"],
        "summary": "Realizar Login",
        "description": "Autentica o utilizador com email e senha. Em caso de sucesso, redireciona para o dashboard.",
        "operationId": "loginAction",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["emailLogin", "senhaLogin"],
                "properties": {
                  "emailLogin": {
                    "type": "string",
                    "format": "email",
                    "example": "admin@assistencia.ao"
                  },
                  "senhaLogin": {
                    "type": "string",
                    "format": "password",
                    "example": "senha123"
                  },
                  "btnLogin": {
                    "type": "string",
                    "description": "Botão de submissão"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "302": { "description": "Redirecciona para o dashboard em caso de sucesso ou de volta ao login em caso de erro" }
        }
      }
    },
    "/sair": {
      "get": {
        "tags": ["Autenticação"],
        "summary": "Logout",
        "description": "Termina a sessão do utilizador e redireciona para a página de login.",
        "operationId": "logout",
        "responses": {
          "302": { "description": "Redireciona para /login" }
        }
      }
    },
    "/dashboard": {
      "get": {
        "tags": ["Relatórios & Dashboard"],

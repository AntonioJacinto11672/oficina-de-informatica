        "description": "Painel com resumo de serviços, orçamentos, movimentações, compras, vendas e contas. **Requer autenticação.**",
        "operationId": "dashboard",
        "security": [{ "sessionAuth": [] }],
        "responses": {
          "200": { "description": "Página HTML do dashboard" },
          "302": { "description": "Redireciona para /login se não autenticado" }
        }
      }
    },

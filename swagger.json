        "tags": ["Autenticação"],
        "summary": "Perfil do Utilizador",
        "description": "Edição do perfil do utilizador autenticado. **Requer autenticação.**",
        "operationId": "perfil",
        "security": [{ "sessionAuth": [] }],
        "responses": {
          "200": { "description": "Página HTML do perfil" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "degraded", "error"],
            "description": "Estado geral da aplicação"
          },
          "app": { "type": "string", "example": "Sistema de Gestão de Assistência Técnica Informática" },
          "version": { "type": "string", "example": "3.0.0" },
          "php": { "type": "string", "example": "8.2.0" },
          "timestamp": { "type": "string", "format": "date-time", "example": "2026-06-17 10:00:00" },
          "checks": {
            "type": "object",
            "properties": {
              "config": { "$ref": "#/components/schemas/HealthCheck" },
              "dependencies": { "$ref": "#/components/schemas/HealthCheck" },
              "database": { "$ref": "#/components/schemas/HealthCheck" },
              "php_extensions": { "$ref": "#/components/schemas/HealthCheck" }
            }
          }
        }
      },
      "HealthCheck": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ok", "warning", "error"] },
          "message": { "type": "string" }
        }
      }
    },
    "securitySchemes": {
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "PHPSESSID",
        "description": "Autenticação via sessão PHP. Realizar login em /login para obter o cookie de sessão."
      }
    }
  }
}

{
  "openapi": "3.0.3",
  "info": {
    "title": "Sistema de Gestão de Manutenção Preventiva e Corretiva de Equipamentos Informáticos da Universidade Lusíada de Angola",
    "description": "Sistema institucional interno do Departamento de TI da Universidade Lusíada de Angola. Gere equipamentos, técnicos, departamentos, fornecedores, peças/consumíveis e o ciclo de manutenção (Ocorrência → Diagnóstico → Execução → Conclusão → Histórico). Não é uma oficina comercial: não existem clientes externos, vendas, orçamentos comerciais ou comissões.\n\n## Autenticação\nO sistema usa sessões PHP (cookie de sessão). Realize login em `/login` antes de aceder a rotas restritas.\n\n## Navegação\nAs páginas são acedidas via `?url=<rota>` ou pela URL amigável `/<rota>` (mod_rewrite).\n\n## Papéis\n`gerente` — acesso total. `tecnico` — acesso às rotas de manutenção partilhadas.",
    "version": "5.0.0",
    "contact": {
      "name": "Josimar Ferreira",
      "email": "josimardasilvaf36@gmail.com"
    },
    "license": {
      "name": "Uso privado"
    }
  },
  "servers": [
    { "url": "http://localhost/oficina-de-informatica", "description": "Servidor local (XAMPP)" }
  ],
  "tags": [
    { "name": "Sistema", "description": "Monitorização e documentação" },
    { "name": "Autenticação", "description": "Login, logout e recuperação de senha" },
    { "name": "Cadastros", "description": "Utilizadores, Técnicos, Departamentos, Equipamentos, Fornecedores, Tipos de Manutenção, Peças e Consumíveis" },
    { "name": "Manutenção", "description": "Ocorrências, Diagnósticos, Execuções, Planeamento Preventivo, Histórico, Abatimento" },
    { "name": "Stock", "description": "Entradas, Saídas, Compras, Stock Baixo" },
    { "name": "Relatórios", "description": "Relatórios institucionais e estatísticas" },
    { "name": "Perfil", "description": "Perfil do utilizador autenticado" }
  ],
  "paths": {
    "/health.php": {
      "get": { "tags": ["Sistema"], "summary": "Estado do sistema (config, dependências, BD, extensões PHP)", "responses": { "200": { "description": "OK" }, "503": { "description": "Erro crítico" } } }
    },
    "/login": {
      "get": { "tags": ["Autenticação"], "summary": "Formulário de login", "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["Autenticação"], "summary": "Autenticar (btnUsuario, btnPassword)", "responses": { "302": { "description": "Redireciona para /home" } } }
    },
    "/sair": { "get": { "tags": ["Autenticação"], "summary": "Terminar sessão", "responses": { "302": { "description": "Redireciona para /login" } } } },
    "/recuperarSenha": { "get": { "tags": ["Autenticação"], "summary": "Fluxo de recuperação de senha (e-mail, código, nova senha)", "responses": { "200": { "description": "OK" } } } },
    "/home": { "get": { "tags": ["Sistema"], "summary": "Dashboard (Gerente ou Técnico, consoante o papel autenticado)", "responses": { "200": { "description": "OK" } } } },
    "/perfil": { "post": { "tags": ["Perfil"], "summary": "Atualizar perfil do utilizador autenticado", "responses": { "302": { "description": "Redireciona para /home" } } } },
    "/editarFoto": { "get": { "tags": ["Cadastros"], "summary": "Alterar fotografia de uma peça/consumível" } },
    "/utilizador": { "get": { "tags": ["Cadastros"], "summary": "Gestão de contas (Gerente)" } },
    "/tecnico": { "get": { "tags": ["Cadastros"], "summary": "CRUD de Técnicos (Gerente)" } },
    "/departamento": { "get": { "tags": ["Cadastros"], "summary": "CRUD de Departamentos (Gerente)" } },
    "/equipamento": { "get": { "tags": ["Cadastros"], "summary": "CRUD de Equipamentos; ?historico=id para o histórico de manutenção" } },
    "/fornecedor": { "get": { "tags": ["Cadastros"], "summary": "CRUD de Fornecedores (Gerente)" } },
    "/tipoManutencao": { "get": { "tags": ["Cadastros"], "summary": "CRUD de Tipos de Manutenção (Gerente)" } },
    "/categoria": { "get": { "tags": ["Cadastros"], "summary": "CRUD de Categorias de Peças (Gerente)" } },
    "/produto": { "get": { "tags": ["Cadastros"], "summary": "CRUD de Peças e Consumíveis (Gerente)" } },
    "/categoriaEquipamento": { "get": { "tags": ["Cadastros"], "summary": "CRUD de Categorias de Equipamento (Gerente)" } },
    "/ocorrencia": { "get": { "tags": ["Manutenção"], "summary": "Ocorrências; ?historico=id para detalhe/histórico de uma ocorrência" } },
    "/diagnostico": { "get": { "tags": ["Manutenção"], "summary": "Diagnósticos; ?ocorrencia=id para os de uma ocorrência" } },
    "/execucao": { "get": { "tags": ["Manutenção"], "summary": "Execuções de manutenção; ?ocorrencia=id para as de uma ocorrência" } },
    "/planeamento": { "get": { "tags": ["Manutenção"], "summary": "Planeamento de Manutenção Preventiva (Gerente)" } },
    "/historico": { "get": { "tags": ["Manutenção"], "summary": "Histórico de manutenções concluídas/canceladas" } },
    "/abatimento": { "get": { "tags": ["Manutenção"], "summary": "Abatimento de Equipamentos (Gerente)" } },
    "/movimentoEstoque": { "get": { "tags": ["Stock"], "summary": "?tipo=Entrada|Saida para o ecrã de Entradas/Saídas; ?produto=id para o histórico de uma peça" } },
    "/compras": { "get": { "tags": ["Stock"], "summary": "Compras a Fornecedores (Gerente)" } },
    "/estoque": { "get": { "tags": ["Stock"], "summary": "Stock Baixo (Gerente)" } },
    "/relatorio": { "get": { "tags": ["Relatórios"], "summary": "?tipo=<equipamentos|tecnicos|ocorrencias|diagnosticos|manutencoes|planeamento|historico|fornecedores|stock|compras>; &export=csv para exportação" } },
    "/graficos": { "get": { "tags": ["Relatórios"], "summary": "Estatísticas de manutenção (Gerente)" } },
    "/configuracoes": { "get": { "tags": ["Sistema"], "summary": "Configurações institucionais (leitura, Gerente)" } }
  }
}

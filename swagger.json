    "/tecnico": {
      "get": {
        "tags": ["Pessoas"],
        "summary": "Listagem de Técnicos",
        "description": "Lista todos os técnicos cadastrados. **Requer autenticação.**",
        "operationId": "listTecnicos",
        "security": [{ "sessionAuth": [] }],
        "responses": {
          "200": { "description": "Página HTML com tabela de técnicos" }
        }
      },
      "post": {
        "tags": ["Pessoas"],
        "summary": "Criar / Editar / Eliminar Técnico",
        "description": "Opera sobre técnicos conforme o botão submetido. **Requer autenticação.**",
        "operationId": "tecnicoCrud",
        "security": [{ "sessionAuth": [] }],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "nbi": { "type": "string", "example": "012345678LA042" },
                  "nif": { "type": "string", "example": "5417891234" },
                  "nome": { "type": "string", "example": "João" },
                  "sobrenome": { "type": "string", "example": "Silva" },
                  "email": { "type": "string", "format": "email" },
                  "telefone": { "type": "string", "example": "+244 923 456 789" },
                  "morada": { "type": "string", "example": "Luanda, Ingombota" },
                  "foto": { "type": "string", "format": "binary" },
                  "btnCdsTecnico": { "type": "string", "description": "Submeter para cadastrar" },
                  "btnEditTecnico": { "type": "string", "description": "Submeter para editar" },
                  "btnDeleteTecnico": { "type": "string", "description": "Submeter para eliminar" }
                }
              }
            }
          }
        },
        "responses": {
          "302": { "description": "Redireciona para /tecnico após a operação" }
        }
      }
    },
